import os
import time
import threading
import psycopg2
from dotenv import load_dotenv
from flask import Flask, Response

from prometheus_client import Counter, generate_latest, CONTENT_TYPE_LATEST

app = Flask(__name__)

# Prometheus metric
REQUEST_COUNT = Counter(
    "flask_http_requests_total",
    "Total HTTP Requests"
)

def load_env():
    load_dotenv()
    return {
        "APP_NAME": os.getenv("APP_NAME"),
        "DATABASE_URL": os.getenv("DATABASE_URL")
    }

def check_db_connection(db_url):
    try:
        conn = psycopg2.connect(db_url)
        conn.close()
        return True
    except Exception:
        return False

def log_env_and_db():
    while True:
        env = load_env()

        print(f"[ENV] APP_NAME={env['APP_NAME']}, DATABASE_URL={env['DATABASE_URL']}")

        db_status = check_db_connection(env["DATABASE_URL"])
        print("[DB STATUS]", "connected" if db_status else "not connected")

        time.sleep(1)

@app.route("/")
def index():
    REQUEST_COUNT.inc()
    return "Flask App Running..."

@app.route("/metrics")
def metrics():
    return Response(generate_latest(), mimetype=CONTENT_TYPE_LATEST)

if __name__ == "__main__":
    threading.Thread(target=log_env_and_db, daemon=True).start()
    app.run(host="0.0.0.0", port=5000, debug=True)
